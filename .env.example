# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Supabase (never expose SERVICE_ROLE to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Binance public market data (no API key required)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# News providers (optional; ingestion skips providers without keys)
CRYPTO_NEWS_API_KEY=
CRYPTOPANIC_AUTH_TOKEN=
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# LLM (backend-only; at least one provider recommended for sentiment)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
LLM_PROVIDER=openai

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000

# Signal / risk defaults (overridable)
SIGNAL_COOLDOWN_MINUTES=30
SIGNAL_EXPIRATION_MINUTES=240
MIN_STOP_DISTANCE_PCT=1.5
MAX_STOP_DISTANCE_PCT=3.5
STOP_BUFFER_PCT=0.5
MIN_TP1_R=1.5
MIN_TP2_R=2.5
AGGRESSIVE_MODE=false
NEWS_INGEST_INTERVAL_SECONDS=300

# Confluence weights (must sum to 1.0)
WEIGHT_NEWS=0.25
WEIGHT_MOMENTUM=0.20
WEIGHT_VOLUME=0.15
WEIGHT_SUPERTREND=0.15
WEIGHT_EWO=0.10
WEIGHT_RSI=0.05
WEIGHT_SR=0.10
